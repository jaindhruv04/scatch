<%- include('./partials/header') %>

<% if(success.length>0){ %>
<div class="absolute top-5 left-1/2 -translate-x-1/2 -translate-y-1/2 p-3 rounded-md bg-blue-500">
  <span class="inline-block mt-1 mb-1 text-white">
    <%= success %>
  </span>
</div>
<% } %>

<div class="flex flex-1 overflow-hidden">
  <div class="w-[20%] flex flex-col items-start px-6 py-10 shrink-0" style="background-color: #081020;">
    <a class="block w-fit mb-4 font-medium text-gray-300 transition-colors hover:text-[#ffd266]" href="/owners/admin">All Products</a>
    <a class="block w-fit mb-4 font-medium text-[#ffd266]" href="/owners/admin/create">Create New Product</a>
  </div>

  <div class="flex-1 overflow-y-auto px-10 py-10" style="background-color: #F4F7FA;">
    <div class="w-full max-w-2xl">
      <div class="rounded-2xl bg-white p-6 shadow-md">
        <h3 class="mb-5 rounded-xl bg-slate-900 py-3 text-center text-xl font-semibold text-white">Create New Product</h3>
        <form autocomplete="off" action="/products/create" method="post" enctype="multipart/form-data">

          <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-slate-500">Product Details</p>
          <div class="mb-4">
            <label class="mb-1 block text-sm font-medium text-slate-700">Product Image</label>
            <input name="image" type="file" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-800 outline-none">
          </div>
          <div class="mb-4 grid grid-cols-2 gap-4">
            <input name="name" type="text" placeholder="Product Name" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-800 outline-none focus:border-slate-400">
            <input name="price" type="text" placeholder="Product Price" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-800 outline-none focus:border-slate-400">
          </div>
          <div class="mb-6">
            <input name="discount" type="text" placeholder="Discount %" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-800 outline-none focus:border-slate-400">
          </div>

          <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-slate-500">Panel Details</p>
          <div class="mb-4 grid grid-cols-2 gap-4">
            <input name="bgcolor" type="text" placeholder="Background Color" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-800 outline-none focus:border-slate-400">
            <input name="panelcolor" type="text" placeholder="Panel Color" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-800 outline-none focus:border-slate-400">
          </div>
          <div class="mb-6">
            <input name="textcolor" type="text" placeholder="Text Color" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-800 outline-none focus:border-slate-400">
          </div>

          <button type="submit" class="w-full rounded-xl bg-slate-900 py-3 font-semibold text-white transition-colors hover:bg-[#ffd266] hover:text-slate-900">Create New Product</button>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('./partials/footer') %>
