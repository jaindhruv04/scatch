<%- include('./partials/header') %>

<% if(user.cart.length > 0){ %>
<div class="w-full flex-1 overflow-y-auto bg-slate-50 px-5 py-8 lg:px-10 lg:py-10">
  <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
    <% user.cart.forEach(function(product){ %>
    <div class="overflow-hidden rounded-2xl bg-white shadow-md">
      <div class="flex h-48 w-full items-center justify-center bg-[<%= product.bgcolor %>] sm:h-56">
        <% if(product.image){ %>
        <img class="h-36 w-36 object-contain sm:h-44 sm:w-44" src="data:image/jpeg;base64,<%= product.image.toString('base64') %>" alt="">
        <% } %>
      </div>
      <div class="flex w-full items-center justify-between bg-[<%= product.panelcolor %>] px-4 py-3">
        <h3 class="truncate text-base font-bold text-[<%= product.textcolor %>]"><%= product.name %></h3>
        <a href="/removefromcart/<%= product._id %>">
          <i class="ri-subtract-line flex h-9 w-9 items-center justify-center rounded-full bg-white text-sm text-red-500 transition-transform hover:scale-110"></i>
        </a>
      </div>
      <div class="flex items-center justify-between bg-[<%= product.panelcolor %>] px-4 pb-4">
        <h4 class="text-sm text-[<%= product.textcolor %>]">Net Total</h4>
        <h4 class="text-sm text-[<%= product.textcolor %>]">₹ <%= product.price %></h4>
      </div>
    </div>
    <% }) %>
  </div>
  <div class="my-10 h-px w-full bg-slate-200"></div>
  <div class="flex justify-center">
    <div class="w-full max-w-md rounded-2xl bg-white p-6 shadow-md">
      <h3 class="mb-5 rounded-xl bg-slate-900 py-3 text-center text-xl font-semibold text-white">Price Breakdown</h3>
      <div class="flex justify-between py-2 border-b border-gray-200">
        <h4 class="text-gray-600">Total MRP</h4>
        <h4>₹ <%= user.cart.reduce((acc, item) => acc + Number(item.price), 0) %></h4>
      </div>
      <div class="flex justify-between py-2 border-b border-gray-200">
        <h4 class="text-gray-600">Discount on MRP</h4>
        <h4 class="text-green-600">- ₹ <%= user.cart.reduce((acc, item) => acc + (Number(item.price) * Number(item.discount) / 100), 0) %></h4>
      </div>
      <div class="flex justify-between py-2 border-b border-gray-200">
        <h4 class="text-gray-600">Platform Fee</h4>
        <h4>₹ 20</h4>
      </div>
      <div class="flex justify-between py-2 border-b border-gray-200">
        <h4 class="text-gray-600">Shipping Fee</h4>
        <h4 class="text-green-600">FREE</h4>
      </div>
      <div class="flex justify-between py-4 mt-2">
        <h3 class="text-lg font-semibold">Total Amount</h3>
        <h3 class="text-lg font-bold text-green-600">₹ <%= bill %></h3>
      </div>
      <button class="mt-2 w-full rounded-xl bg-slate-900 py-3 font-semibold text-white transition-colors hover:bg-[#ffd266] hover:text-slate-900">Proceed to Checkout</button>
    </div>
  </div>
</div>
<% } else { %>
<div class="flex flex-1 items-center justify-center bg-slate-50 px-5">
  <h1 class="rounded-2xl bg-white px-8 py-10 text-center text-2xl font-semibold text-slate-500 shadow-sm">Your Cart Is Empty</h1>
</div>
<% } %>

<%- include('./partials/footer') %>
