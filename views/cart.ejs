<%- include('./partials/header') %>

<div class="flex-1 overflow-y-auto w-full px-20 py-10">
  <div class="flex flex-wrap gap-6">
    <% user.cart.forEach(function(product){ %>
    <div class="w-56 rounded-md overflow-hidden shadow-sm">
      <div class="w-full h-52 flex items-center justify-center bg-[<%= product.bgcolor %>]">
        <% if(product.image){ %>
        <img class="h-[12rem]" src="data:image/jpeg;base64,<%= product.image.toString('base64') %>" alt="">
        <% } %>
      </div>
      <div class="w-full flex justify-between px-4 py-3 bg-[<%= product.panelcolor %>]">
        <h3 class="text-lg text-[<%= product.textcolor %>]"><%= product.name %></h3>
        <div class="flex items-center gap-1">
          <i class="w-6 h-6 bg-white flex rounded-full items-center justify-center ri-add-line text-sm"></i>
          <div class="px-2 py-1 rounded-md bg-white text-black text-sm">01</div>
          <i class="w-6 h-6 bg-white flex rounded-full items-center justify-center ri-subtract-line text-sm"></i>
        </div>
      </div>
      <div class="flex items-center justify-between px-4 py-2 bg-[<%= product.panelcolor %>]">
        <h4 class="text-sm text-[<%= product.textcolor %>]">Net Total</h4>
        <h4 class="text-sm text-[<%= product.textcolor %>]">₹ <%= product.price %></h4>
      </div>
    </div>
    <% }) %>
  </div>

  <div class="w-full h-[1px] bg-gray-300 my-10"></div>

  <div class="flex justify-center">
    <div class="w-full max-w-md">
      <h3 class="text-2xl text-white font-semibold mb-5 text-center bg-zinc-700 rounded-md">Price Breakdown</h3>
      <div class="flex justify-between py-2 border-b border-gray-200">
        <h4 class="text-gray-600">Total MRP</h4>
        <h4>₹ <%= user.cart.reduce((acc, item) => acc + Number(item.price), 0) %></h4>
      </div>
      <div class="flex justify-between py-2 border-b border-gray-200">
        <h4 class="text-gray-600">Discount on MRP</h4>
        <h4 class="text-green-600">- ₹ <%= user.cart.reduce((acc, item) => acc + (Number(item.price) * Number(item.discount) / 100), 0) %></h4>
      </div>
      <div class="flex justify-between py-2 border-b border-gray-200">
        <h4 class="text-gray-600">Platform Fee</h4>
        <h4>₹ 20</h4>
      </div>
      <div class="flex justify-between py-2 border-b border-gray-200">
        <h4 class="text-gray-600">Shipping Fee</h4>
        <h4 class="text-green-600">FREE</h4>
      </div>
      <div class="flex justify-between py-4 mt-2">
        <h3 class="text-lg font-semibold">Total Amount</h3>
        <h3 class="text-lg font-bold text-green-600">₹ <%= bill %></h3>
      </div>
      <button class="w-full py-3 rounded-full text-white font-medium mt-2" style="background-color: #25282C;">Proceed to Checkout</button>
    </div>
  </div>

</div>

<%- include('./partials/footer') %>
