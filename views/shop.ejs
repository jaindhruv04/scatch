<%- include('./partials/header') %>

<% if(success.length>0){ %>
<div class="absolute top-5 left-1/2 -translate-x-1/2 -translate-y-1/2 p-3 rounded-md bg-blue-500">
  <span class="inline-block mt-1 mb-1 text-white">
    <%= success %>
  </span>
</div>
<% } %>

<% if(error.length>0){ %>
<div class="absolute top-5 left-1/2 -translate-x-1/2 -translate-y-1/2 p-3 rounded-md bg-red-500">
  <span class="inline-block mt-1 mb-1 text-white">
    <%= error %>
  </span>
</div>
<% } %>


<div class="flex flex-1 flex-col overflow-y-auto lg:flex-row" style="background-color: #F5F7F8;">
  <div class="w-full shrink-0 px-5 py-6 text-white lg:w-[20%] lg:px-6 lg:py-10 lg:overflow-y-auto" style="background-color: #0B1117;">

    
    <div class="w-full">
      <button onclick="toggleSection('sort-options', this)"
        class="w-full flex justify-between items-center font-semibold uppercase text-sm tracking-wider">
        Sort By
        <i class="ri-arrow-down-s-line text-lg transition-transform duration-200"></i>
      </button>
      <div id="sort-options" class="flex flex-col mt-3">
        <a class="block w-fit mb-3  hover:text-gray-900" href="">Popular</a>
        <a class="block w-fit mb-3  hover:text-gray-900" href="">Newest</a>
      </div>
    </div>

    <hr class="border-gray-400 my-6 w-full">

  
    <div class="w-full ">
      <button onclick="toggleSection('collection-options', this)"
        class="w-full flex justify-between items-center  font-semibold uppercase text-sm tracking-wider">
        Collections
        <i class="ri-arrow-down-s-line text-lg transition-transform duration-200"></i>
      </button>
      <div id="collection-options" class="flex flex-col mt-3">
        <a class="block w-fit mb-3  hover:text-gray-900" href="">New Collection</a>
        <a class="block w-fit mb-3  hover:text-gray-900" href="">All Products</a>
        <a class="block w-fit mb-3  hover:text-gray-900" href="">Discounted Products</a>
      </div>
    </div>

    <hr class="border-gray-400 my-6 w-full">

    <div class="w-full">
      <button onclick="toggleSection('filter-options', this)"
        class="w-full flex justify-between items-center  font-semibold uppercase text-sm tracking-wider">
        Filter By
        <i class="ri-arrow-down-s-line text-lg transition-transform duration-200"></i>
      </button>
      <div id="filter-options" class="flex flex-col mt-3">
        <a class="block w-fit mb-3  hover:text-gray-900" href="">Availability</a>
        <a class="block w-fit mb-3  hover:text-gray-900" href="">Discount</a>
      </div>
    </div>

  </div>
  <div class="w-full px-5 py-7 lg:w-[80%] lg:overflow-y-auto lg:px-10 lg:py-10" >
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
      <% products.forEach(function(product){ %>
<div class="group w-full overflow-hidden rounded-2xl bg-white shadow-sm transition-transform duration-200 hover:-translate-y-1 hover:shadow-lg" >
  <div class="flex h-40 w-full items-center justify-center bg-[<%= product.bgcolor %>] sm:h-52">
    <% if(product.image){ %>
    <img class="h-28 w-28 object-contain transition-transform duration-300 group-hover:scale-105 sm:h-40 sm:w-40" src="data:image/jpeg;base64,<%= product.image.toString('base64') %>" alt="">
    <% } %>
  </div>
  <div class="flex justify-between bg-[<%= product.panelcolor %>] items-center px-4 py-3 min-h-[78px] text-[<%= product.textcolor %>]">
    <div class="min-w-0">
      <h3 class="text-sm font-bold">
        <%= product.name %>
      </h3>
      <h4 class="mt-1 text-xs font-medium opacity-80">₹ <%= product.price %>
      </h4>
    </div>
    <a class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white text-lg text-slate-900 transition-transform hover:scale-110" href="/addtocart/<%=product._id%>">
      <i class="ri-add-line"></i>
    </a>
  </div>
</div>
<% }) %>
</div>
</div>
</div>
<script>
  function toggleSection(id, btn) {
    const el = document.getElementById(id);
    const icon = btn.querySelector('i');
    el.classList.toggle('hidden');
    icon.classList.toggle('rotate-180');
  }
</script>

<%- include('./partials/footer') %>