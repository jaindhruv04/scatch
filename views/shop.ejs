<%- include('./partials/header') %>

<% if(success.length>0){ %>
<div class="absolute top-5 left-1/2 -translate-x-1/2 -translate-y-1/2 p-3 rounded-md bg-blue-500">
  <span class="inline-block mt-1 mb-1 text-white">
    <%= success %>
  </span>
</div>
<% } %>

<% if(error.length>0){ %>
<div class="absolute top-5 left-1/2 -translate-x-1/2 -translate-y-1/2 p-3 rounded-md bg-red-500">
  <span class="inline-block mt-1 mb-1 text-white">
    <%= error %>
  </span>
</div>
<% } %>


<div class="flex flex-1 flex-col overflow-y-auto" style="background-color: #F4F7FA;">
  <div class="flex w-full flex-wrap items-start gap-4 border-b border-slate-800 bg-[#08131f] px-5 py-5 text-white lg:px-10" style="background-color: #08131F;">

    <div class="w-full">
      <form method="GET" action="/shop">
        <input name="q" type="text" placeholder="Search products..." class="w-full rounded-xl border border-slate-700 bg-slate-900/50 px-4 py-3 text-sm text-slate-100 placeholder-slate-400 outline-none focus:border-slate-500">
      </form>
    </div>

    <div class="w-full rounded-xl border border-slate-800 bg-slate-900/50 p-4 md:w-[calc(33.333%-0.75rem)]">
      <button onclick="toggleSection('sort-options', this)"
        class="flex w-full items-center justify-between text-xs font-semibold uppercase tracking-wider text-slate-100">
        Sort By
        <i class="ri-arrow-down-s-line text-lg transition-transform duration-200"></i>
      </button>
      <div id="sort-options" class="flex flex-col mt-3">
        <a class="mb-2 block w-fit text-sm text-slate-300 transition-colors hover:text-[#ffd266]" href="">Popular</a>
        <a class="block w-fit text-sm text-slate-300 transition-colors hover:text-[#ffd266]" href="">Newest</a>
      </div>
    </div>

    <hr class="hidden">

  
    <div class="w-full rounded-xl border border-slate-800 bg-slate-900/50 p-4 md:w-[calc(33.333%-0.75rem)]">
      <button onclick="toggleSection('collection-options', this)"
        class="flex w-full items-center justify-between text-xs font-semibold uppercase tracking-wider text-slate-100">
        Collections
        <i class="ri-arrow-down-s-line text-lg transition-transform duration-200"></i>
      </button>
      <div id="collection-options" class="flex flex-col mt-3">
        <a class="mb-2 block w-fit text-sm text-slate-300 transition-colors hover:text-[#ffd266]" href="">New Collection</a>
        <a class="mb-2 block w-fit text-sm text-slate-300 transition-colors hover:text-[#ffd266]" href="">All Products</a>
        <a class="block w-fit text-sm text-slate-300 transition-colors hover:text-[#ffd266]" href="">Discounted Products</a>
      </div>
    </div>

    <hr class="hidden">

    <div class="w-full rounded-xl border border-slate-800 bg-slate-900/50 p-4 md:w-[calc(33.333%-0.75rem)]">
      <button onclick="toggleSection('filter-options', this)"
        class="flex w-full items-center justify-between text-xs font-semibold uppercase tracking-wider text-slate-100">
        Filter By
        <i class="ri-arrow-down-s-line text-lg transition-transform duration-200"></i>
      </button>
      <div id="filter-options" class="flex flex-col mt-3">
        <a class="mb-2 block w-fit text-sm text-slate-300 transition-colors hover:text-[#ffd266]" href="">Availability</a>
        <a class="block w-fit text-sm text-slate-300 transition-colors hover:text-[#ffd266]" href="">Discount</a>
      </div>
    </div>

  </div>
  <div class="w-full px-5 py-10 lg:px-10 lg:py-12" >
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <% products.forEach(function(product){ %>
<div class="group product-card w-full overflow-hidden rounded-2xl bg-white shadow-md transition-transform duration-300 hover:-translate-y-1 hover:shadow-xl" data-name="<%= product.name %>">
  <div class="flex h-56 w-full items-center justify-center bg-[<%= product.bgcolor %>] sm:h-64">
    <% if(product.image){ %>
    <img class="h-40 w-40 object-contain transition-transform duration-300 group-hover:scale-105 sm:h-48 sm:w-48" src="data:image/jpeg;base64,<%= product.image.toString('base64') %>" alt="">
    <% } %>
  </div>
  <div class="flex justify-between bg-[<%= product.panelcolor %>] items-center px-4 py-3 min-h-[78px] text-[<%= product.textcolor %>]">
    <div class="min-w-0">
      <h3 class="truncate text-sm font-bold">
        <%= product.name %>
      </h3>
      <h4 class="mt-1 text-xs font-medium opacity-80">₹ <%= product.price %>
      </h4>
    </div>
    <a class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white text-lg text-slate-900 transition-transform hover:scale-110" href="/addtocart/<%=product._id%>">
      <i class="ri-add-line"></i>
    </a>
  </div>
</div>
<% }) %>
</div>
</div>
</div>
<script>
  function toggleSection(id, btn) {
    const el = document.getElementById(id);
    const icon = btn.querySelector('i');
    el.classList.toggle('hidden');
    icon.classList.toggle('rotate-180');
  }
</script>

<%- include('./partials/footer') %>
