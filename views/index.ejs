<%- include('./partials/header') %>

<% if(error.length>0){ %>
<div class="fixed left-1/2 top-5 z-50 -translate-x-1/2 rounded-xl bg-red-500 px-4 py-3 shadow-lg">
  <span class="text-sm font-medium text-white">
    <%= error %>
  </span>
</div>
<% } %>
<div class="flex w-full flex-1 flex-col bg-slate-50 lg:flex-row">
  <div class="flex w-full items-center justify-center px-5 py-12 lg:w-1/2 lg:px-16">
    <div class="w-full max-w-md rounded-2xl bg-white p-7 shadow-sm sm:p-9">
      <h3 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">welcome to <span class="font-semibold text-[#d89d2b]">Solar</span></h3>
      <h4 class="mb-6 text-xl font-semibold text-slate-700">create your account</h4>
      <form autocomplete="off" action="/users/register" method="post">
        <input class="mb-3 block w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-slate-900 outline-none transition focus:border-[#ffd266] focus:ring-2 focus:ring-[#ffd266]/30" type="text" placeholder="Full Name" name="fullname">
        <input class="mb-3 block w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-slate-900 outline-none transition focus:border-[#ffd266] focus:ring-2 focus:ring-[#ffd266]/30" type="email" placeholder="Email" name="email">
        <input class="mb-3 block w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-slate-900 outline-none transition focus:border-[#ffd266] focus:ring-2 focus:ring-[#ffd266]/30" type="password" placeholder="Password" name="password">
        <input class="mt-3 w-full rounded-xl bg-slate-900 px-5 py-3 font-semibold text-white transition-colors hover:bg-[#ffd266] hover:text-slate-900" type="submit" value="Create My Account">
      </form>
    </div>
  </div>
  <div class="flex w-full items-center justify-center px-5 py-12 lg:w-1/2 lg:px-16">
    <div class="w-full max-w-md rounded-2xl bg-white p-7 shadow-sm sm:p-9">
      <h4 class="mb-6 text-xl font-semibold text-slate-700">login your account</h4>
      <form autocomplete="off" action="/users/login" method="post">
        <input class="mb-3 block w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-slate-900 outline-none transition focus:border-[#ffd266] focus:ring-2 focus:ring-[#ffd266]/30" type="email" placeholder="Email" name="email">
        <input class="mb-3 block w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-slate-900 outline-none transition focus:border-[#ffd266] focus:ring-2 focus:ring-[#ffd266]/30" type="password" placeholder="Password" name="password">
        <input class="mt-3 block w-full rounded-xl bg-slate-900 px-5 py-3 font-semibold text-white transition-colors hover:bg-[#ffd266] hover:text-slate-900" type="submit" value="Login">
      </form>
    </div>
  </div>
</div>
<%- include('./partials/footer') %>
