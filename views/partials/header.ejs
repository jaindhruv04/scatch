        <h3 class="text-4xl font-semibold text-white">Scatch</h3>
        <% var loggedin = typeof loggedin != "undefined" ? loggedin : true %>
        <% if(loggedin){ %>
        <div class="flex gap-6 text-xl">
            <a class="text-gray-300 hover:text-white transition-colors" href="/shop">Shop</a>
            <a class="text-gray-300 hover:text-white transition-colors" href="/cart">Cart</a>
            <a class="text-gray-300 hover:text-white transition-colors" href="">My Account</a>
            <a class="text-red-400 hover:text-red-300 transition-colors" href="/users/logout">Logout</a>
        </div>
        <% } %>
    </nav>
