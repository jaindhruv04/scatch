<%- include('./partials/header') %>

<% if(success.length>0){ %>
<div class="absolute top-5 left-1/2 -translate-x-1/2 -translate-y-1/2 p-3 rounded-md bg-blue-500">
  <span class="inline-block mt-1 mb-1 text-white">
    <%= success %>
  </span>
</div>
<% } %>

<div class="flex md:hidden w-full gap-6 px-5 py-3" style="background-color: #081020;">
  <a class="font-medium text-gray-300 transition-colors hover:text-[#ffd266]" href="/owners/admin">All Products</a>
  <a class="font-medium text-gray-300 transition-colors hover:text-[#ffd266]" href="/owners/admin/create">Create New Product</a>
</div>

<div class="flex flex-1 overflow-hidden">
  <div class="hidden md:flex md:w-[20%] flex-col items-start px-6 py-10 shrink-0" style="background-color: #081020;">
    <a class="block w-fit mb-4 font-medium text-gray-300 transition-colors hover:text-[#ffd266]" href="/owners/admin">All Products</a>
    <a class="block w-fit mb-4 font-medium text-gray-300 transition-colors hover:text-[#ffd266]" href="/owners/admin/create">Create New Product</a>
  </div>

  <div class="flex-1 overflow-y-auto px-5 py-6 md:px-10 md:py-10" style="background-color: #F4F7FA;">
    <% if(products.length > 0){ %>
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      <% products.forEach(function(product){ %>
      <div class="group w-full overflow-hidden rounded-2xl bg-white shadow-md transition-transform duration-300 hover:-translate-y-1 hover:shadow-xl">
        <div class="flex h-52 w-full items-center justify-center bg-[<%= product.bgcolor %>]">
          <% if(product.image){ %>
          <img class="h-40 w-40 object-contain transition-transform duration-300 group-hover:scale-105" src="data:image/jpeg;base64,<%= product.image.toString('base64') %>" alt="">
          <% } %>
        </div>
        <div class="flex justify-between bg-[<%= product.panelcolor %>] items-center px-4 py-3 min-h-[78px] text-[<%= product.textcolor %>]">
          <div class="min-w-0">
            <h3 class="truncate text-sm font-bold"><%= product.name %></h3>
            <h4 class="mt-1 text-xs font-medium opacity-80">₹ <%= product.price %></h4>
          </div>
          <div class="flex items-center gap-2">
            <a href="/owners/admin/edit/<%= product._id %>">
              <i class="w-7 h-7 bg-white flex rounded-full items-center justify-center ri-edit-line text-sm text-blue-500 transition-transform hover:scale-110"></i>
            </a>
            <a href="/owners/admin/delete/<%= product._id %>" onclick="return confirm('Are you sure you want to delete this product?')">
              <i class="w-7 h-7 bg-white flex rounded-full items-center justify-center ri-delete-bin-line text-sm text-red-500 transition-transform hover:scale-110"></i>
            </a>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
    <% } else { %>
    <div class="flex items-center justify-center h-full">
      <h2 class="rounded-2xl bg-white px-8 py-10 text-center text-2xl font-semibold text-slate-500 shadow-sm">No Products Yet</h2>
    </div>
    <% } %>
  </div>
</div>

<%- include('./partials/footer') %>
