<%- include('./partials/header') %>

<% if(success.length>0){ %>
<div class="absolute top-5 left-1/2 -translate-x-1/2 -translate-y-1/2 p-3 rounded-md bg-blue-500">
  <span class="inline-block mt-1 mb-1 text-white">
    <%= success %>
  </span>
</div>
<% } %>

<div class="flex flex-1 overflow-hidden">
  <div class="w-[20%] flex flex-col items-start px-6 py-10 shrink-0" style="background-color: #D1D5DB;">
    <a class="block w-fit mb-4 font-medium text-gray-700 hover:text-gray-900" href="/owners/admin">All Products</a>
    <a class="block w-fit mb-4 font-medium text-gray-700 hover:text-gray-900" href="/owners/admin/create">Create New Product</a>
  </div>

  <div class="flex-1 overflow-y-auto px-10 py-10" style="background-color: #60a7ca;">
    <% if(products.length > 0){ %>
    <div class="flex flex-wrap gap-6">
      <% products.forEach(function(product){ %>
      <div class="w-56 rounded-md overflow-hidden shadow-sm">
        <div class="w-full h-52 flex items-center justify-center bg-[<%= product.bgcolor %>]">
          <% if(product.image){ %>
          <img class="h-[12rem]" src="data:image/jpeg;base64,<%= product.image.toString('base64') %>" alt="">
          <% } %>
        </div>
        <div class="w-full flex justify-between px-4 py-3 bg-[<%= product.panelcolor %>]">
          <div>
            <h3 class="text-[<%= product.textcolor %>]"><%= product.name %></h3>
            <h4 class="text-sm text-[<%= product.textcolor %>]">₹ <%= product.price %></h4>
          </div>
          <div class="flex items-center gap-2">
            <a href="/owners/admin/edit/<%= product._id %>">
              <i class="w-7 h-7 bg-white flex rounded-full items-center justify-center ri-edit-line text-sm text-blue-500"></i>
            </a>
            <a href="/owners/admin/delete/<%= product._id %>" onclick="return confirm('Are you sure you want to delete this product?')">
              <i class="w-7 h-7 bg-white flex rounded-full items-center justify-center ri-delete-bin-line text-sm text-red-500"></i>
            </a>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
    <% } else { %>
    <div class="flex items-center justify-center h-full">
      <h2 class="text-xl text-gray-500">No Products Yet</h2>
    </div>
    <% } %>
  </div>
</div>

<%- include('./partials/footer') %>